config KERNEL_HACK
	tristate "Kernel Hack Driver (stealth read/write)"
	default m
	help
	  Driver kernel untuk membaca dan menulis memori proses secara langsung.
	  Mendukung penyembunyian diri dari /proc/modules, /proc/misc,
	  /proc/kallsyms, /sys/module/, dan lsmod.
	  Nama device node dibuat acak setiap kali driver dimuat.

config HW_BREAKPOINT_MODE
	bool "Hardware Breakpoint support in kernel_hack"
	depends on KERNEL_HACK && HW_BREAKPOINT
	default y
	help
	  Tambahkan dukungan hardware breakpoint ke driver kernel_hack.
	  Membutuhkan CONFIG_HW_BREAKPOINT=y di kernel.
